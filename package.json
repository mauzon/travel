  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.51.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  }
