{
  "name": "travel-places",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node build.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "sync-list": "node scripts/sync-list.mjs --all",
    "migrate-origins": "node scripts/migrate-origins.mjs",
    "add-origin": "node scripts/add-origin.mjs",
    "enrich-routes": "node scripts/enrich-routes.mjs",
    "enrich-transit": "node scripts/enrich-transit.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:london": "node scripts/demo.mjs london",
    "demo:clear": "node scripts/demo.mjs clear",
    "instance": "node scripts/instance.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "check:maps-links": "node scripts/check-maps-links.mjs",
    "fix:maps-links": "node scripts/fix-maps-links.mjs --write",
    "generate:icons": "node scripts/generate-icons.mjs",
    "remove-place": "node scripts/remove-place.mjs",
