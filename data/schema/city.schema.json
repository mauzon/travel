{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pinkeepr.local/schema/city.schema.json",
  "title": "Travel city bundle",
  "type": "object",
  "required": [
    "slug",
    "name_ru",
    "country",
    "timezone",
    "currency",
    "hotel",
    "transport",
    "places",
    "events",
    "sources"
  ],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name_ru": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "timezone": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "hotel": { "$ref": "#/$defs/hotel" },
    "origins": { "type": "array", "items": { "$ref": "#/$defs/origin" } },
    "transport": { "$ref": "#/$defs/transport" },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "sources": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 1
    },
    "routing": { "type": "object" },
    "ui": { "type": "object" }
  },
  "$defs": {
    "rating": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 5 },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "originRoutes": {
      "type": "object",
      "properties": {
        "walk": { "$ref": "#/$defs/routeLeg" },
        "taxi": { "$ref": "#/$defs/taxiLeg" },
        "transit": { "$ref": "#/$defs/transitLeg" },
        "sort_km": { "type": "number" }
      }
    },
    "origin": {
      "type": "object",
      "required": ["id", "label_ru", "label_en", "kind", "lat", "lng"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label_ru": { "type": "string" },
        "label_en": { "type": "string" },
        "kind": { "enum": ["hotel", "venue", "other"] },
        "default": { "type": "boolean" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "google_maps_url": { "type": "string", "format": "uri" },
        "google": {
          "type": "object",
          "properties": {
            "cid": { "type": "string" },
            "place_id": { "type": "string" },
            "mid": { "type": "string" },
            "maps_url": { "type": "string", "format": "uri" },
            "feature_id": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "routeLeg": {
      "type": "object",
      "properties": {
        "km": { "type": "number" },
        "min": { "type": "number" },
        "label": { "type": "string" },
        "practical": { "type": "boolean" }
      }
    },
    "taxiLeg": {
      "type": "object",
      "properties": {
        "km": { "type": "number" },
        "min_low": { "type": "number" },
        "min_high": { "type": "number" },
        "thb_min": { "type": "number" },
        "thb_max": { "type": "number" },
        "label": { "type": "string" }
      }
    },
    "transitLeg": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "description": { "type": "string" },
        "description_en": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "hotel": {
      "type": "object",
      "required": ["name", "address", "lat", "lng", "maps_url", "stay"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "maps_url": { "type": "string", "format": "uri" },
        "google": {
          "type": "object",
          "properties": {
            "cid": { "type": "string" },
            "place_id": { "type": "string" },
            "mid": { "type": "string" },
            "maps_url": { "type": "string", "format": "uri" },
            "feature_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "district": { "type": "string" },
        "rating": { "$ref": "#/$defs/rating" },
        "stay": {
          "type": "object",
          "required": ["check_in", "check_out"],
          "properties": {
            "check_in": { "type": "string", "format": "date" },
            "check_out": { "type": "string", "format": "date" },
            "label": { "type": "string" }
          }
        },
        "transit_description": { "type": "string" }
      }
    },
    "transport": {
      "type": "object",
      "required": ["taxi"],
      "properties": {
        "taxi": {
          "type": "object",
          "required": ["base_fare_thb", "per_km_thb_min", "per_km_thb_max", "traffic_factor"],
          "properties": {
            "base_fare_thb": { "type": "number" },
            "per_km_thb_min": { "type": "number" },
            "per_km_thb_max": { "type": "number" },
            "traffic_factor": { "type": "number", "minimum": 1 },
            "note": { "type": "string" }
          }
        },
        "transit_description": { "type": "string" }
      }
    },
    "place": {
      "type": "object",
      "required": ["id", "name", "category", "source", "maps_url", "sort_km"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "source": { "enum": ["list", "added", "event"] },
        "user_note": {
          "type": "string",
          "description": "Owner note from Google Maps list (not translated)"
        },
        "description": {
          "type": "string",
          "description": "Assistant-written place description"
        },
        "description_en": { "type": "string" },
        "name_en": { "type": "string" },
        "note_en": { "type": "string" },
        "warning": { "type": "string" },
        "icon": { "type": "string" },
        "district": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "maps_url": { "type": "string" },
        "maps_place_id": { "type": "string" },
        "google": {
          "type": "object",
          "properties": {
            "cid": { "type": "string" },
            "place_id": { "type": "string" },
            "mid": { "type": "string" },
            "maps_url": { "type": "string", "format": "uri" },
            "feature_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "address": { "type": "string" },
        "rating": { "$ref": "#/$defs/rating" },
        "walk": { "$ref": "#/$defs/routeLeg" },
        "taxi": { "$ref": "#/$defs/taxiLeg" },
        "transit": { "$ref": "#/$defs/transitLeg" },
        "sort_km": { "type": "number" },
        "daytrip": { "type": "boolean" },
        "routes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/originRoutes" }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "name", "category", "source", "maps_url", "schedule_text", "sort_km"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "const": "events" },
        "source": { "const": "event" },
        "schedule_text": { "type": "string" },
        "start_local": { "type": "string" },
        "end_local": { "type": "string" },
        "outside_stay": { "type": "boolean" },
        "source_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "user_note": { "type": "string" },
        "warning": { "type": "string" },
        "district": { "type": "string" },
        "maps_url": { "type": "string" },
        "google": {
          "type": "object",
          "properties": {
            "cid": { "type": "string" },
            "place_id": { "type": "string" },
            "mid": { "type": "string" },
            "maps_url": { "type": "string", "format": "uri" },
            "feature_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "rating": { "$ref": "#/$defs/rating" },
        "walk": { "$ref": "#/$defs/routeLeg" },
        "taxi": { "$ref": "#/$defs/taxiLeg" },
        "transit": { "$ref": "#/$defs/transitLeg" },
        "sort_km": { "type": "number" },
        "daytrip": { "type": "boolean" },
        "routes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/originRoutes" }
        }
      }
    }
  }
}
